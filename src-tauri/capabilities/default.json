{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Edunova desktop client",
  "windows": ["main", "splash"],
  "remote": {
    "urls": ["https://edunovamis.lovable.app/*", "https://*.lovable.app/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:webview:allow-print",
    "shell:allow-open",
    "dialog:default",
    "process:default",
    "os:default"
  ]
}
