{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edunova",
  "version": "1.0.0",
  "identifier": "com.edunova.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Edunova",
        "url": "https://edunovamis.lovable.app/auth/login?desktop=1",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0C0E14",
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "splash",
        "url": "splash.html",
        "width": 520,
        "height": 340,
        "center": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#0C0E14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Edunova Desktop",
    "longDescription": "Edunova — Management Intelligence System. Fast, lightweight and secure desktop client for schools and institutions."
  },
  "plugins": {}
}
